# GraphQL API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql

# Public upload delivery should use a dedicated static/uploads origin in production.
# Example: https://uploads.your-domain.com
NEXT_PUBLIC_UPLOADS_ORIGIN=http://localhost:3001

# Feature Flags
# Set to 'false' to disable user statistics when backend resolver is not available
NEXT_PUBLIC_ENABLE_USER_STATS=true

# Development/Debug Settings
# Set to 'true' to enable detailed GraphQL error logging
NEXT_PUBLIC_DEBUG_GRAPHQL=false

# Add other environment variables as needed
# DATABASE_URL should use a least-privileged app database user.
# Do not use owner/superuser credentials in the admin runtime.
# DATABASE_URL=
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=
